            'Ejercicios de resistencia a presión psicológica',
            'Desarrollo de pensamiento crítico en situaciones de estrés'
          ],
          prerequisites: ['Fundamentos de Ingeniería Social']
        },
        'pretexting-financial': {
          icon: '🎪',
          duration: '4 min',
          difficulty: 'Avanzado',
          category: 'Pretexting',
          learningObjectives: [
            'Identificar narrativas falsas específicas del sector financiero',
            'Reconocer identidades falsas de reguladores y auditores',
