---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LessonCard from '../components/LessonCard.astro';

// Lecciones completas del sistema - Iguales a las del dashboard principal
const todayLessons = [
  {
    id: 'phishing-basics',
    title: 'Fundamentos del Phishing',
    description: 'Aprende a identificar correos electrónicos maliciosos dirigidos al sector financiero colombiano.',
    duration: '4 min',
    difficulty: 'Fácil' as const,
    completed: false,
    points: 50,
    category: 'Phishing',
    icon: '📧'
  },
  {
    id: 'social-engineering',
    title: 'Ingeniería Social en Entidades Financieras',
    description: 'Técnicas comunes de manipulación utilizadas contra empleados de instituciones financieras.',
    duration: '5 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 40,
    category: 'Ingeniería Social',
    icon: '🎭'
  },
  {
    id: 'password-security',
    title: 'Seguridad de Contraseñas',
    description: 'Mejores prácticas para crear y gestionar contraseñas seguras en entornos financieros.',
    duration: '3 min',
    difficulty: 'Fácil' as const,
    completed: false,
    points: 20,
    category: 'Autenticación',
    icon: '🔐'
  },
  {
    id: 'manipulation-techniques',
    title: 'Técnicas de Manipulación',
    description: 'Identifica y combate técnicas psicológicas usadas contra empleados del sector financiero.',
    duration: '6 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 35,
    category: 'Psicología',
    icon: '🧠'
  },
  {
    id: 'pretexting-financial',
    title: 'Pretexting en el Sector Financiero',
    description: 'Reconoce y previene ataques de suplantación específicos en instituciones financieras.',
    duration: '4 min',
    difficulty: 'Avanzado' as const,
    completed: false,
    points: 45,
    category: 'Pretexting',
    icon: '🎪'
  },
  {
    id: 'secure-passwords',
    title: 'Creación de Contraseñas Seguras',
    description: 'Domina técnicas avanzadas para crear contraseñas robustas que protejan sistemas financieros.',
    duration: '5 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 35,
    category: 'Autenticación',
    icon: '�'
  },
  {
    id: 'two-factor-auth',
    title: 'Autenticación de Dos Factores',
    description: 'Implementa y gestiona sistemas 2FA para máxima seguridad en operaciones bancarias.',
    duration: '4 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 40,
    category: 'Autenticación',
    icon: '🛡️'
  },
  {
    id: 'superintendencia-guidelines',
    title: 'Directrices de la Superintendencia',
    description: 'Cumple con las normativas de ciberseguridad establecidas por la Superintendencia Financiera de Colombia.',
    duration: '6 min',
    difficulty: 'Avanzado' as const,
    completed: false,
    points: 50,
    category: 'Regulatorio',
    icon: '⚖️'
  },
  {
    id: 'incident-reporting',
    title: 'Reporte de Incidentes de Seguridad',
    description: 'Protocolos efectivos para reportar y gestionar incidentes de seguridad en tiempo real.',
    duration: '4 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 45,
    category: 'Gestión de Incidentes',
    icon: '🚨'
  }
];

// Organizar lecciones por categorías
const learningModules = {
  'Phishing y Correos Maliciosos': todayLessons.filter(lesson => lesson.category === 'Phishing'),
  'Ingeniería Social y Manipulación': todayLessons.filter(lesson => 
    lesson.category === 'Ingeniería Social' || lesson.category === 'Psicología' || lesson.category === 'Pretexting'
  ),
  'Autenticación y Contraseñas': todayLessons.filter(lesson => lesson.category === 'Autenticación'),
  'Cumplimiento Regulatorio': todayLessons.filter(lesson => lesson.category === 'Regulatorio'),
  'Gestión de Incidentes': todayLessons.filter(lesson => lesson.category === 'Gestión de Incidentes')
};

// Sistema de estadísticas dinámicas conectado al proceso
const dynamicStats = {
  totalLessons: 9,
  completedLessons: 0,
  totalPoints: 0,
  availablePoints: 360, // 9 lecciones × 40 puntos cada una
  averageTime: '5 min',
  currentLevel: 1,
  currentLevelPoints: 0,
  nextLevelPoints: 100
};
---

<Layout title="Micro-Learning - SecureLearn Pro">
  <Navigation />
  
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-green-600 to-teal-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          📚 Micro-Learning
        </h1>
        <p class="text-xl text-green-100 mb-8 max-w-3xl mx-auto">
          Vista previa de lecciones de ciberseguridad. Para estudiar completo, ve al Dashboard principal.
        </p>
        <div class="flex justify-center">
          <button 
            onclick="window.location.href='/'"
            class="bg-white text-green-600 px-8 py-3 rounded-lg font-bold hover:bg-green-50 transition-colors transform hover:scale-105"
          >
            🎓 Ir al Dashboard para Estudiar
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Progreso y Estadísticas Dinámicas -->
  <section class="py-12 -mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Descripción de Micro-Learning -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl shadow-lg p-8 mb-12 border border-blue-200">
        <div class="text-center max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-800 mb-6 flex items-center justify-center gap-3">
            🧠 ¿Qué es Micro-Learning?
          </h2>
          
          <div class="grid md:grid-cols-2 gap-8 text-left">
            <div>
              <h3 class="text-xl font-semibold text-blue-600 mb-4 flex items-center gap-2">
                ⚡ Aprendizaje Eficiente
              </h3>
              <p class="text-gray-700 mb-4">
                El <strong>Micro-Learning</strong> es una metodología educativa que divide el contenido en pequeñas unidades digestibles de 3-7 minutos. Esta página te permite explorar las lecciones antes de estudiarlas completamente en el Dashboard.
              </p>
              <ul class="text-gray-600 space-y-2">
                <li class="flex items-center gap-2">
                  <span class="text-green-500">✓</span> Retención mejorada del conocimiento
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-green-500">✓</span> Menor fatiga cognitiva
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-green-500">✓</span> Flexibilidad de horarios
                </li>
              </ul>
            </div>
            
            <div>
              <h3 class="text-xl font-semibold text-purple-600 mb-4 flex items-center gap-2">
                🎯 Importancia Moderna
              </h3>
              <p class="text-gray-700 mb-4">
                En la era digital, nuestra capacidad de atención es limitada. El Micro-Learning se adapta a cómo funcionan nuestros cerebros, permitiendo un aprendizaje más efectivo y duradero en ciberseguridad.
              </p>
              <ul class="text-gray-600 space-y-2">
                <li class="flex items-center gap-2">
                  <span class="text-purple-500">🧠</span> Adaptado al span de atención moderno
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-purple-500">📱</span> Compatible con dispositivos móviles
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-purple-500">⏰</span> Encaja en horarios ocupados
                </li>
              </ul>
            </div>
          </div>
          
          <div class="mt-8 p-6 bg-white rounded-lg border border-blue-200">
            <p class="text-lg text-gray-700 italic">
              "Para aprender profundamente, ve al <strong>Dashboard</strong>. Para explorar y prepararte, usa esta sección de <strong>Micro-Learning</strong>."
            </p>
          </div>
        </div>
      </div>

      <!-- Alerta Informativa -->
      <div class="bg-blue-50 border-l-4 border-blue-400 p-6 rounded-lg mb-12">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">
              👁️ Vista Previa de Lecciones
            </h3>
            <div class="mt-2 text-sm text-blue-700">
              <p>
                Esta página muestra <strong>vistas previas informativas</strong> de las lecciones disponibles. 
                Para acceder al <strong>contenido completo interactivo</strong> y ganar puntos, 
                <a href="/" class="underline font-medium">ve al Dashboard principal</a>.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Módulos de Aprendizaje -->
      {Object.entries(learningModules).map(([category, lessons]) => (
        <div class="mb-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
              {category === 'Phishing y Correos Maliciosos' && '📧'}
              {category === 'Ingeniería Social y Manipulación' && '🎭'}
              {category === 'Autenticación y Contraseñas' && '🔐'}
              {category === 'Cumplimiento Regulatorio' && '📋'}
              {category === 'Gestión de Incidentes' && '🚨'}
              <span>{category}</span>
            </h2>
            <div class="text-sm text-gray-600 bg-gray-100 px-3 py-1 rounded-full">
              {lessons.length} lección{lessons.length !== 1 ? 'es' : ''}
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {lessons.map((lesson) => (
              <LessonCard lesson={lesson} />
            ))}
          </div>
        </div>
      ))}

      <!-- Call to Action -->
      <div class="text-center mt-16">
        <div class="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl p-8 text-white">
          <h3 class="text-2xl font-bold mb-4">� ¿Listo para aprender?</h3>
          <p class="text-purple-100 mb-6 max-w-2xl mx-auto">
            Has explorado las vistas previas de nuestras lecciones. 
            Ahora ve al Dashboard principal para acceder al contenido completo, 
            ganar puntos y completar tu entrenamiento en ciberseguridad.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button 
              onclick="window.location.href='/'"
              class="bg-white text-purple-600 px-8 py-3 rounded-lg font-bold hover:bg-purple-50 transition-colors"
            >
              🚀 Ir al Dashboard Principal
            </button>
            <button 
              onclick="window.location.href='/simulator'"
              class="border-2 border-white text-white px-8 py-3 rounded-lg font-medium hover:bg-white hover:text-purple-600 transition-colors"
            >
              🎯 Simulador de Ataques
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal de Lección -->
  <div id="lessonModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div id="modalContent" class="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300">
      <!-- El contenido del modal se carga dinámicamente aquí -->
    </div>
  </div>
</Layout>

<script is:inline>
  // @ts-nocheck
  // Sistema de lecciones para la página de micro-learning
  class MicroLearningSystem {
    constructor() {
      this.initializeEventListeners();
    }

    initializeEventListeners() {
      // Event listeners para las tarjetas de lecciones
      document.addEventListener('click', (e) => {
        if (e.target.closest('[data-lesson-id]')) {
          const lessonCard = e.target.closest('[data-lesson-id]');
          const lessonId = lessonCard.dataset.lessonId;
          const lessonTitle = lessonCard.dataset.lessonTitle;
          const lessonPoints = lessonCard.dataset.lessonPoints;
          
          this.openLessonModal(lessonId, lessonTitle, lessonPoints);
        }
        
        if (e.target.id === 'closeModal' || e.target.closest('#lessonModal') === e.target) {
          this.closeLessonModal();
        }
        
        if (e.target.id === 'completeLesson') {
          this.completeCurrentLesson();
        }
      });
    }

    openLessonModal(lessonId, lessonTitle, lessonPoints) {
      const modal = document.getElementById('lessonModal');
      const modalContent = document.getElementById('modalContent');
      
      // En micro-learning solo mostramos vista previa informativa
      const content = this.getLessonPreview(lessonId, lessonTitle, lessonPoints);
      
      modalContent.innerHTML = content;
      
      // Mostrar modal con animación
      modal.classList.remove('hidden');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 50);
    }

    closeLessonModal() {
      const modal = document.getElementById('lessonModal');
      const modalContent = document.getElementById('modalContent');
      
      modalContent.classList.add('scale-95', 'opacity-0');
      modalContent.classList.remove('scale-100', 'opacity-100');
      
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    getLessonPreview(lessonId, lessonTitle, lessonPoints) {
      const lessonData = this.getLessonData(lessonId);
      
      return `
        <div class="p-8 max-h-[80vh] overflow-y-auto">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-2xl">
                ${lessonData.icon}
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900">${lessonTitle}</h2>
                <p class="text-blue-600 font-medium">🏆 ${lessonPoints} puntos disponibles</p>
              </div>
            </div>
            <button id="closeModal" class="text-gray-400 hover:text-gray-600 text-2xl">✕</button>
          </div>

          <div class="space-y-6">
            <!-- Vista Previa del Contenido -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-xl border-l-4 border-blue-400">
              <h3 class="text-lg font-semibold text-gray-900 mb-3">📚 ¿Qué aprenderás en esta lección?</h3>
              <div class="space-y-3">
                ${lessonData.learningObjectives.map(objective => `
                  <div class="flex items-start space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span class="text-gray-700">${objective}</span>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Información de la Lección -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-green-50 p-4 rounded-lg text-center border border-green-200">
                <div class="text-2xl font-bold text-green-600 mb-1">${lessonData.duration}</div>
                <div class="text-sm text-green-700">Duración</div>
              </div>
              <div class="bg-purple-50 p-4 rounded-lg text-center border border-purple-200">
                <div class="text-2xl font-bold text-purple-600 mb-1">${lessonData.difficulty}</div>
                <div class="text-sm text-purple-700">Dificultad</div>
              </div>
              <div class="bg-orange-50 p-4 rounded-lg text-center border border-orange-200">
                <div class="text-2xl font-bold text-orange-600 mb-1">${lessonData.category}</div>
                <div class="text-sm text-orange-700">Categoría</div>
              </div>
            </div>

            <!-- Contenido Destacado -->
            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="font-semibold text-gray-800 mb-3">🎯 Contenido Destacado</h4>
              <div class="space-y-2">
                ${lessonData.highlights.map(highlight => `
                  <div class="flex items-center space-x-2">
                    <span class="text-green-500">✓</span>
                    <span class="text-gray-700 text-sm">${highlight}</span>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Prerrequisitos -->
            ${lessonData.prerequisites.length > 0 ? `
              <div class="bg-yellow-50 p-4 rounded-lg border border-yellow-200">
                <h4 class="font-semibold text-yellow-800 mb-2">⚠️ Prerrequisitos</h4>
                <ul class="text-sm text-yellow-700 space-y-1">
                  ${lessonData.prerequisites.map(prereq => `<li>• ${prereq}</li>`).join('')}
                </ul>
              </div>
            ` : ''}

            <!-- Acciones -->
            <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200">
              <button 
                onclick="window.location.href='/'" 
                class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200 flex items-center justify-center gap-2"
              >
                <span>📖</span>
                Ir al Dashboard para Estudiar
              </button>
              <button 
                id="closeModal"
                class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium transition-colors duration-200"
              >
                Cerrar Vista Previa
              </button>
            </div>
          </div>
        </div>
      `;
    }

    getLessonData(lessonId) {
      const lessonsData = {
        'phishing-basics': {
          icon: '📧',
          duration: '4 min',
          difficulty: 'Fácil',
          category: 'Phishing',
