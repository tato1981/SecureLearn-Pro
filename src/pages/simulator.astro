---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

// Datos de ejemplo para simulacros de phishing
const phishingScenarios = [
  {
    id: 'superfinanciera-fake',
    title: 'Correo de la Superintendencia Financiera',
    description: 'Simulacro de correo fraudulento que suplanta a la Superintendencia Financiera de Colombia',
    difficulty: 'Intermedio',
    sector: 'Regulatorio',
    points: 50,
    completed: false,
    preview: 'Estimado funcionario, hemos detectado irregularidades en su institución...'
  },
  {
    id: 'cliente-urgente',
    title: 'Cliente VIP - Transferencia Urgente',
    description: 'Simulación de petición fraudulenta de un supuesto cliente importante',
    difficulty: 'Avanzado',
    sector: 'Atención al Cliente',
    points: 75,
    completed: true,
    preview: 'Buenos días, soy el Sr. García, cliente platino de su banco...'
  },
  {
    id: 'sistema-interno',
    title: 'Mantenimiento del Sistema Bancario',
    description: 'Correo falso sobre actualización de credenciales del sistema interno',
    difficulty: 'Fácil',
    sector: 'Sistemas',
    points: 30,
    completed: false,
    preview: 'El sistema bancario requiere actualización de credenciales...'
  }
];

const stats = {
  totalScenarios: 15,
  completed: 8,
  successRate: 85,
  averageTime: '2.3 min'
};
---

<Layout title="Simulador de Phishing - SecureLearn Pro">
  <Navigation />
  
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-red-600 to-orange-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          🎯 Simulador de Phishing
        </h1>
        <p class="text-xl text-red-100 mb-8 max-w-3xl mx-auto">
          Practica identificando ataques de phishing específicos del sector financiero colombiano
        </p>
      </div>
    </div>
  </section>

  <!-- Estadísticas -->
  <section class="py-12 -mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-3xl font-bold text-blue-600 mb-2">{stats.totalScenarios}</div>
          <div class="text-gray-600">Escenarios Totales</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-3xl font-bold text-green-600 mb-2">{stats.completed}</div>
          <div class="text-gray-600">Completados</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-3xl font-bold text-purple-600 mb-2">{stats.successRate}%</div>
          <div class="text-gray-600">Tasa de Éxito</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-3xl font-bold text-orange-600 mb-2">{stats.averageTime}</div>
          <div class="text-gray-600">Tiempo Promedio</div>
        </div>
      </div>

      <!-- Simulacros Disponibles -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Simulacros Contextualizados</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
          {phishingScenarios.map((scenario) => (
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6 hover:shadow-xl transition-all duration-300">
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">🎭</span>
                  <div>
                    <h3 class="font-semibold text-gray-900">{scenario.title}</h3>
                    <p class="text-sm text-gray-600">{scenario.sector}</p>
                  </div>
                </div>
                {scenario.completed && (
                  <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-medium">
                    ✓ Completado
                  </span>
                )}
              </div>
              
              <p class="text-gray-700 text-sm mb-4">{scenario.description}</p>
              
              <div class="bg-gray-50 p-3 rounded-lg mb-4">
                <p class="text-xs text-gray-600 italic">"{scenario.preview}"</p>
              </div>
              
              <div class="flex items-center justify-between mb-4">
                <span class={`px-2 py-1 rounded-full text-xs font-medium ${
                  scenario.difficulty === 'Fácil' ? 'bg-green-100 text-green-800' :
                  scenario.difficulty === 'Intermedio' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {scenario.difficulty}
                </span>
                <span class="text-blue-600 font-medium text-sm">+{scenario.points} pts</span>
              </div>
              
              <button class={`w-full py-3 px-4 rounded-lg font-medium transition-all duration-200 ${
                scenario.completed 
                  ? 'bg-gray-100 text-gray-600 cursor-default' 
                  : 'bg-red-600 text-white hover:bg-red-700'
              }`}>
                {scenario.completed ? 'Revisar Simulacro' : 'Iniciar Simulacro'}
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Información Educativa -->
      <div class="bg-blue-50 rounded-xl p-8">
        <h3 class="text-xl font-bold text-blue-900 mb-4">💡 ¿Sabías que...?</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-semibold text-blue-800 mb-2">Phishing en el Sector Financiero</h4>
            <p class="text-blue-700 text-sm">
              El 75% de los ataques cibernéticos contra bancos en Colombia comienzan con un correo de phishing dirigido a empleados.
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-blue-800 mb-2">Técnicas Más Comunes</h4>
            <p class="text-blue-700 text-sm">
              Los atacantes suplantan entidades como la Superintendencia Financiera, clientes VIP y proveedores de sistemas bancarios.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        ¿Listo para el Desafío?
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Cada simulacro completado te acerca más a convertirte en un experto en detección de phishing.
      </p>
      <button class="bg-blue-600 text-white px-8 py-4 rounded-lg font-medium hover:bg-blue-700 transition-colors text-lg">
        Comenzar Simulacro Aleatorio
      </button>
    </div>
  </section>
</Layout>