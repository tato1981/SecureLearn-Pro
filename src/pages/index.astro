      getGenericLessonContent(title, points) {
        return `
          <div class="p-8">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h2 class="text-2xl font-bold text-gray-900">${title}</h2>
                <p class="text-blue-600 font-medium">🏆 ${points} puntos disponibles</p>
              </div>
              <button id="closeModal" class="text-gray-400 hover:text-gray-600 text-2xl">✕</button>
            </div>
            
            <div class="bg-blue-50 p-6 rounded-xl text-center">
              <div class="text-4xl mb-4">🚧</div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Lección en desarrollo</h3>
              <p class="text-gray-700 mb-6">Esta lección estará disponible próximamente.</p>
              <button id="completeLesson" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                Marcar como vista (+${points} pts)
              </button>
            </div>
          </div>
        `;
      }

      bindModalEvents(lessonId, lessonTitle, lessonPoints) {
        const closeBtn = document.getElementById('closeModal');
        const completeBtn = document.getElementById('completeLesson');
        const modal = document.getElementById('lessonModal');
        const modalContent = document.getElementById('modalContent');

        // Cerrar modal
        const closeModal = () => {
          modalContent.classList.add('scale-95', 'opacity-0');
          modalContent.classList.remove('scale-100', 'opacity-100');
          setTimeout(() => {
            modal.classList.add('hidden');
          }, 300);
        };

        closeBtn.addEventListener('click', closeModal);
        
        // Cerrar con click fuera del modal
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        // Completar lección
        completeBtn.addEventListener('click', () => {
          this.completeLesson(lessonId, lessonTitle, parseInt(lessonPoints));
          closeModal();
        });
      }

      completeLesson(lessonId, lessonTitle, points) {
        if (window.gameSystem) {
          const completed = window.gameSystem.completeLesson(lessonId, lessonTitle, points);
          
          if (completed) {
            // Actualizar estadísticas diarias
            const user = window.authSystem?.getCurrentUser();
            if (user && window.updateDailyStatsOnLessonComplete) {
              window.updateDailyStatsOnLessonComplete(user.email, points);
            }
            
            // Actualizar UI del botón
            const button = document.querySelector(`[data-lesson-id="${lessonId}"]`);
            if (button) {
              this.markLessonCompleted(button);
            }
            
            // Mostrar notificación de éxito
            this.showSuccessNotification(lessonTitle, points);
            
            // Actualizar estadísticas en tiempo real
            setTimeout(() => {
              if (window.gameSystem) {
                window.gameSystem.updateUI();
              }
              
              // Notificar a otras páginas sobre la actualización
              try {
                localStorage.setItem('statsUpdateTrigger', Date.now().toString());
                console.log('Stats update trigger sent from Dashboard');
              } catch (e) {
                console.log('Error triggering stats update:', e);
              }
            }, 500);
          }
        }
      }

      showSuccessNotification(lessonTitle, points) {
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 bg-green-500 text-white p-4 rounded-lg shadow-lg z-50 transform transition-all duration-300';
        notification.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="text-2xl">🎉</span>
            <div>
              <div class="font-semibold">¡Lección completada!</div>
              <div class="text-sm opacity-90">${lessonTitle} (+${points} pts)</div>
            </div>
          </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
          notification.style.transform = 'translateX(100%)';
          setTimeout(() => notification.remove(), 300);
        }, 4000);
      }
    }

    // Inicializar sistema de lecciones
    window.lessonSystem = new LessonSystem();

    // Actualizar estadísticas cuando el usuario regresa a la página
    window.addEventListener('focus', () => {
      setTimeout(() => {
        if (window.authSystem && window.authSystem.isLoggedIn()) {
          const user = window.authSystem.getCurrentUser();
          if (user) {
            updateDailyStats(user);
          }
        }
      }, 300);
    });
  </script>
</Layout>