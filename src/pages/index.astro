---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProgressCard from '../components/ProgressCard.astro';
import BadgeCollection from '../components/BadgeCollection.astro';
import LessonCard from '../components/LessonCard.astro';

// Datos de ejemplo para el dashboard
const userProgress = {
  points: 150,
  level: 2
};

const badges = [
  {
    id: 'first-lesson',
    name: 'Primer Paso',
    description: 'Completa tu primera lección',
    icon: '🎯',
    earned: true,
    earnedDate: '15 Oct 2025'
  },
  {
    id: 'phishing-expert',
    name: 'Detector de Phishing',
    description: 'Identifica 10 correos maliciosos',
    icon: '🕵️',
    earned: true,
    earnedDate: '16 Oct 2025'
  },
  {
    id: 'week-streak',
    name: 'Constancia',
    description: 'Aprende durante 7 días seguidos',
    icon: '📅',
    earned: false
  },
  {
    id: 'social-engineer',
    name: 'Anti-Ingeniería Social',
    description: 'Domina técnicas de prevención',
    icon: '🛡️',
    earned: false
  }
];

const todayLessons = [
  {
    id: 'phishing-basics',
    title: 'Fundamentos del Phishing',
    description: 'Aprende a identificar correos electrónicos maliciosos dirigidos al sector financiero colombiano.',
    duration: '4 min',
    difficulty: 'Fácil' as const,
    completed: false, // Inicialmente sin completar
    points: 50,
    category: 'Phishing',
    icon: '📧'
  },
  {
    id: 'social-engineering',
    title: 'Ingeniería Social en Entidades Financieras',
    description: 'Técnicas comunes de manipulación utilizadas contra empleados de instituciones financieras.',
    duration: '5 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 40,
    category: 'Ingeniería Social',
    icon: '🎭'
  },
  {
    id: 'password-security',
    title: 'Seguridad de Contraseñas',
    description: 'Mejores prácticas para crear y gestionar contraseñas seguras en entornos financieros.',
    duration: '3 min',
    difficulty: 'Fácil' as const,
    completed: false,
    points: 20,
    category: 'Autenticación',
    icon: '🔐'
  },
  {
    id: 'manipulation-techniques',
    title: 'Técnicas de Manipulación',
    description: 'Identifica y combate técnicas psicológicas usadas contra empleados del sector financiero.',
    duration: '6 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 35,
    category: 'Psicología',
    icon: '🧠'
  },
  {
    id: 'pretexting-financial',
    title: 'Pretexting en el Sector Financiero',
    description: 'Reconoce y previene ataques de suplantación específicos en instituciones financieras.',
    duration: '4 min',
    difficulty: 'Avanzado' as const,
    completed: false,
    points: 45,
    category: 'Pretexting',
    icon: '🎪'
  },
  {
    id: 'secure-passwords',
    title: 'Creación de Contraseñas Seguras',
    description: 'Domina técnicas avanzadas para crear contraseñas robustas que protejan sistemas financieros.',
    duration: '5 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 35,
    category: 'Autenticación',
    icon: '🔑'
  },
  {
    id: 'two-factor-auth',
    title: 'Autenticación de Dos Factores',
    description: 'Implementa y gestiona sistemas 2FA para máxima seguridad en operaciones bancarias.',
    duration: '4 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 40,
    category: 'Autenticación',
    icon: '🛡️'
  },
  {
    id: 'superintendencia-guidelines',
    title: 'Directrices de la Superintendencia',
    description: 'Cumple con las normativas de ciberseguridad establecidas por la Superintendencia Financiera de Colombia.',
    duration: '6 min',
    difficulty: 'Avanzado' as const,
    completed: false,
    points: 50,
    category: 'Regulatorio',
    icon: '⚖️'
  },
  {
    id: 'incident-reporting',
    title: 'Reporte de Incidentes de Seguridad',
    description: 'Protocolos efectivos para reportar y gestionar incidentes de seguridad en tiempo real.',
    duration: '4 min',
    difficulty: 'Intermedio' as const,
    completed: false,
    points: 45,
    category: 'Gestión de Incidentes',
    icon: '🚨'
  }
];
---

<Layout title="SecureLearn Pro - Dashboard">
  <Navigation />
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span id="welcomeMessage">Bienvenido a</span>
          <span class="text-yellow-300">SecureLearn Pro</span>
        </h1>
        <p class="text-xl text-blue-100 mb-6 max-w-3xl mx-auto">
          Plataforma de micro-learning gamificada para fortalecer la ciberseguridad en instituciones financieras de Colombia
        </p>
        
        <!-- Sección de Motivación con Recompensas -->
        <div class="bg-white bg-opacity-10 backdrop-blur-sm rounded-xl p-6 mb-8 max-w-4xl mx-auto border border-white border-opacity-20">
          <h2 class="text-2xl font-bold text-yellow-300 mb-4 flex items-center justify-center gap-2">
            🏆 ¡Tu Aprendizaje Vale Oro!
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
            <div class="bg-white bg-opacity-20 rounded-lg p-4">
              <div class="text-3xl mb-2">💰</div>
              <h3 class="font-bold text-yellow-200 mb-1">Bonos Especiales</h3>
              <p class="text-sm text-blue-100">Detecta y reporta amenazas reales para recibir bonos económicos</p>
            </div>
            <div class="bg-white bg-opacity-20 rounded-lg p-4">
              <div class="text-3xl mb-2">🏖️</div>
              <h3 class="font-bold text-yellow-200 mb-1">Días de Descanso</h3>
              <p class="text-sm text-blue-100">Prevén ataques exitosamente y gana días libres adicionales</p>
            </div>
            <div class="bg-white bg-opacity-20 rounded-lg p-4">
              <div class="text-3xl mb-2">🎁</div>
              <h3 class="font-bold text-yellow-200 mb-1">Recompensas Premium</h3>
              <p class="text-sm text-blue-100">Accede a beneficios exclusivos y reconocimientos especiales</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="text-blue-100 text-sm">
              <span class="font-semibold text-yellow-300">¡Cada conocimiento cuenta!</span> 
              Tu formación en ciberseguridad no solo protege a la empresa, también te recompensa.
            </p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button 
            id="continueeLearningBtn"
            class="bg-yellow-400 text-blue-900 px-8 py-3 rounded-lg font-bold hover:bg-yellow-300 transition-colors transform hover:scale-105"
          >
            🚀 Continuar Aprendiendo
          </button>
          <button 
            id="viewProgressBtn"
            class="border-2 border-white text-white px-8 py-3 rounded-lg font-medium hover:bg-white hover:text-blue-600 transition-colors"
          >
            📊 Ver Mi Progreso
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard Principal -->
  <section class="py-12 -mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Progreso del Usuario -->
        <div class="lg:col-span-2">
          <ProgressCard points={userProgress.points} level={userProgress.level} />
        </div>
        
        <!-- Estadísticas Dinámicas del Día -->
        <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">📊 Estadísticas del Día</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Lecciones completadas hoy</span>
              <span id="dailyLessonsCompleted" class="font-bold text-blue-600">0/9</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Tiempo de estudio hoy</span>
              <span id="dailyStudyTime" class="font-bold text-green-600">0 min</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Puntos ganados hoy</span>
              <span id="dailyPointsEarned" class="font-bold text-purple-600">0 pts</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Racha actual</span>
              <span id="currentStreak" class="font-bold text-orange-600">0 días</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Meta diaria</span>
              <span id="dailyGoalProgress" class="font-bold text-indigo-600">0/2 lecciones</span>
            </div>
          </div>
          
          <!-- Barra de progreso de meta diaria -->
          <div class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex justify-between text-sm text-gray-600 mb-2">
              <span>Meta diaria de estudio</span>
              <span id="dailyGoalPercentage">0%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div id="dailyGoalBar" class="bg-gradient-to-r from-blue-500 to-purple-600 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lecciones del Día -->
      <div id="lessonsSection" class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
          📚 Lecciones de Hoy
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {todayLessons.map((lesson) => (
            <LessonCard lesson={lesson} />
          ))}
        </div>
      </div>

      <!-- Insignias -->
      <div class="mb-12">
        <BadgeCollection badges={badges} />
      </div>

      <!-- Alertas de Seguridad -->
      <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-400 p-6 rounded-lg">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">
              Alerta de Seguridad - Sector Financiero
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <p>
                Se han detectado nuevas campañas de phishing dirigidas a instituciones bancarias colombianas. 
                <strong>Completa el módulo "Phishing Avanzado"</strong> para estar preparado.
              </p>
            </div>
            <div class="mt-4">
              <button class="bg-red-100 hover:bg-red-200 text-red-800 px-4 py-2 rounded-md text-sm font-medium transition-colors">
                Ver Detalles
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
            🛡️ SecureLearn Pro
          </h3>
          <p class="text-gray-400 mb-4 max-w-md">
            Fortaleciendo la ciberseguridad en el sector financiero colombiano a través del aprendizaje gamificado.
          </p>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Recursos</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#" class="hover:text-white transition-colors">Guías de Seguridad</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Reportar Incidente</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Centro de Ayuda</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold mb-4">Contacto</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#" class="hover:text-white transition-colors">Soporte Técnico</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Feedback</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Sugerencias</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
        <p>&copy; 2025 SecureLearn Pro. Desarrollado por Duberney Obando Cano Tecnologo  
Análisis y Desarrollo de Software</p>
      </div>
    </div>
  </footer>
  
  <!-- Script para personalizar el dashboard -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      personalizeWelcomeMessage();
      updateUserStats();
      
      // Verificar si hay un parámetro de lección en la URL
      const urlParams = new URLSearchParams(window.location.search);
      const lessonParam = urlParams.get('lesson');
      
      if (lessonParam) {
        console.log('🎯 Auto-opening lesson from URL:', lessonParam);
        // Delay para asegurar que el sistema de lecciones esté cargado
        setTimeout(() => {
          const lessonButton = document.querySelector(`[data-lesson-id="${lessonParam}"]`);
          if (lessonButton && window.lessonSystem) {
            lessonButton.click();
            // Limpiar el parámetro de la URL
            window.history.replaceState({}, document.title, window.location.pathname);
          } else {
            console.log('❌ Lesson button not found or lesson system not ready:', lessonParam);
          }
        }, 1000);
      }
      
      // Inicializar estadísticas diarias después de que los sistemas se carguen
      setTimeout(() => {
        if (window.authSystem && window.authSystem.isLoggedIn()) {
          const user = window.authSystem.getCurrentUser();
          if (user) {
            updateDailyStats(user);
          }
        }
      }, 200);

      // Configurar botones de navegación
      setupNavigationButtons();
    });

    function personalizeWelcomeMessage() {
      if (window.authSystem && window.authSystem.isLoggedIn()) {
        const user = window.authSystem.getCurrentUser();
        const welcomeElement = document.getElementById('welcomeMessage');
        if (welcomeElement && user) {
          welcomeElement.textContent = `¡Hola ${user.name}! Bienvenido a`;
        }
      }
    }

    function updateUserStats() {
      if (window.authSystem && window.authSystem.isLoggedIn()) {
        const user = window.authSystem.getCurrentUser();
        if (user) {
          // Actualizar progreso en ProgressCard
          setTimeout(() => {
            if (window.gameSystem) {
              window.gameSystem.syncWithUser(user);
            }
            // Actualizar estadísticas del día
            updateDailyStats(user);
          }, 100);
        }
      }
    }

    function updateDailyStats(user) {
      if (!user) return;

      const today = new Date().toDateString();
      const userEmail = user.email;
      
      // Obtener datos del usuario
      const userProgress = JSON.parse(localStorage.getItem(`userProgress_${userEmail}`) || '{}');
      const gameData = JSON.parse(localStorage.getItem(`gameData_${userEmail}`) || '{}');
      const dailyData = JSON.parse(localStorage.getItem(`dailyStats_${userEmail}`) || '{}');
      const streakData = JSON.parse(localStorage.getItem(`streak_${userEmail}`) || '{}');

      // Calcular estadísticas del día
      const todaysProgress = dailyData[today] || { lessonsCompleted: 0, pointsEarned: 0, studyTimeMinutes: 0 };
      const totalLessonsCompleted = Object.keys(userProgress).length;
      const currentStreak = calculateCurrentStreak(streakData, today);
      
      // Meta diaria (2 lecciones por día)
      const dailyGoal = 2;
      const dailyProgress = Math.min(todaysProgress.lessonsCompleted, dailyGoal);
      const dailyGoalPercentage = Math.round((dailyProgress / dailyGoal) * 100);

      // Actualizar interfaz
      updateDailyStatsUI({
        dailyLessonsCompleted: todaysProgress.lessonsCompleted,
        totalLessons: 9,
        dailyStudyTime: todaysProgress.studyTimeMinutes,
        dailyPointsEarned: todaysProgress.pointsEarned,
        currentStreak,
        dailyGoalProgress: dailyProgress,
        dailyGoal,
        dailyGoalPercentage
      });
    }

    function updateDailyStatsUI(stats) {
      // Actualizar elementos de la interfaz
      const elements = {
        dailyLessonsCompleted: document.getElementById('dailyLessonsCompleted'),
        dailyStudyTime: document.getElementById('dailyStudyTime'),
        dailyPointsEarned: document.getElementById('dailyPointsEarned'),
        currentStreak: document.getElementById('currentStreak'),
        dailyGoalProgress: document.getElementById('dailyGoalProgress'),
        dailyGoalPercentage: document.getElementById('dailyGoalPercentage'),
        dailyGoalBar: document.getElementById('dailyGoalBar')
      };

      if (elements.dailyLessonsCompleted) {
        elements.dailyLessonsCompleted.textContent = `${stats.dailyLessonsCompleted}/${stats.totalLessons}`;
      }

      if (elements.dailyStudyTime) {
        elements.dailyStudyTime.textContent = `${stats.dailyStudyTime} min`;
      }

      if (elements.dailyPointsEarned) {
        elements.dailyPointsEarned.textContent = `${stats.dailyPointsEarned} pts`;
      }

      if (elements.currentStreak) {
        elements.currentStreak.textContent = `${stats.currentStreak} días`;
      }

      if (elements.dailyGoalProgress) {
        elements.dailyGoalProgress.textContent = `${stats.dailyGoalProgress}/${stats.dailyGoal} lecciones`;
      }

      if (elements.dailyGoalPercentage) {
        elements.dailyGoalPercentage.textContent = `${stats.dailyGoalPercentage}%`;
      }

      if (elements.dailyGoalBar) {
        elements.dailyGoalBar.style.width = `${stats.dailyGoalPercentage}%`;
        
        // Cambiar color según el progreso
        if (stats.dailyGoalPercentage >= 100) {
          elements.dailyGoalBar.className = 'bg-gradient-to-r from-green-500 to-emerald-600 h-2 rounded-full transition-all duration-500';
        } else if (stats.dailyGoalPercentage >= 50) {
          elements.dailyGoalBar.className = 'bg-gradient-to-r from-yellow-500 to-orange-600 h-2 rounded-full transition-all duration-500';
        } else {
          elements.dailyGoalBar.className = 'bg-gradient-to-r from-blue-500 to-purple-600 h-2 rounded-full transition-all duration-500';
        }
      }
    }

    function calculateCurrentStreak(streakData, today) {
      const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000).toDateString();
      
      if (streakData.lastStudyDate === today) {
        return streakData.currentStreak || 1;
      } else if (streakData.lastStudyDate === yesterday) {
        return streakData.currentStreak || 0;
      } else {
        return 0;
      }
    }

    // Función para actualizar estadísticas diarias cuando se completa una lección
    function updateDailyStatsOnLessonComplete(userEmail, pointsEarned) {
      const today = new Date().toDateString();
      const dailyData = JSON.parse(localStorage.getItem(`dailyStats_${userEmail}`) || '{}');
      
      if (!dailyData[today]) {
        dailyData[today] = { lessonsCompleted: 0, pointsEarned: 0, studyTimeMinutes: 0 };
      }
      
      dailyData[today].lessonsCompleted += 1;
      dailyData[today].pointsEarned += pointsEarned;
      dailyData[today].studyTimeMinutes += 5; // Aproximadamente 5 minutos por lección
      
      localStorage.setItem(`dailyStats_${userEmail}`, JSON.stringify(dailyData));
      
      // Actualizar racha
      updateStreakData(userEmail, today);
      
      // Recargar estadísticas
      if (window.authSystem && window.authSystem.isLoggedIn()) {
        const user = window.authSystem.getCurrentUser();
        if (user) {
          updateDailyStats(user);
        }
      }
    }

    function updateStreakData(userEmail, today) {
      const streakData = JSON.parse(localStorage.getItem(`streak_${userEmail}`) || '{}');
      const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000).toDateString();
      
      if (streakData.lastStudyDate === today) {
        // Ya estudió hoy, no cambiar la racha
        return;
      } else if (streakData.lastStudyDate === yesterday) {
        // Continuó la racha
        streakData.currentStreak = (streakData.currentStreak || 0) + 1;
      } else {
        // Nueva racha
        streakData.currentStreak = 1;
      }
      
      streakData.lastStudyDate = today;
      localStorage.setItem(`streak_${userEmail}`, JSON.stringify(streakData));
    }

    // Hacer las funciones disponibles globalmente para el sistema de lecciones
    window.updateDailyStatsOnLessonComplete = updateDailyStatsOnLessonComplete;

    // Configurar botones de navegación inteligente
    function setupNavigationButtons() {
      const continueBtn = document.getElementById('continueeLearningBtn');
      const progressBtn = document.getElementById('viewProgressBtn');

      if (continueBtn) {
        continueBtn.addEventListener('click', () => {
          navigateToNextLesson();
        });
      }

      if (progressBtn) {
        progressBtn.addEventListener('click', () => {
          window.location.href = '/profile';
        });
      }
    }

    function navigateToNextLesson() {
      if (!window.authSystem || !window.authSystem.isLoggedIn()) {
        window.location.href = '/login';
        return;
      }

      const user = window.authSystem.getCurrentUser();
      const userProgress = JSON.parse(localStorage.getItem(`userProgress_${user.email}`) || '{}');
      
      // Lista de lecciones en orden de progresión
      const lessonProgression = [
        'phishing-basics',
        'social-engineering', 
        'password-security',
        'two-factor-auth',
        'data-protection',
        'network-security',
        'compliance-basics',
        'regulatory-guidelines',
        'incident-reporting'
      ];

      // Encontrar la siguiente lección a completar
      let nextLessonId = null;
      for (const lessonId of lessonProgression) {
        if (!userProgress[lessonId]) {
          nextLessonId = lessonId;
          break;
        }
      }

      if (nextLessonId) {
        // Abrir modal de la siguiente lección
        const lessonCard = document.querySelector(`[data-lesson-id="${nextLessonId}"]`);
        if (lessonCard) {
          lessonCard.click();
        } else {
          // Si no encuentra la tarjeta, hacer scroll a la sección de lecciones
          const lessonsSection = document.getElementById('lessonsSection');
          if (lessonsSection) {
            lessonsSection.scrollIntoView({ behavior: 'smooth' });
          }
        }
      } else {
        // Si ha completado todas las lecciones, mostrar mensaje de felicitación
        showCompletionMessage();
      }
    }

    function showCompletionMessage() {
      // Crear notificación de felicitación
      const notification = document.createElement('div');
      notification.className = 'fixed top-4 right-4 bg-gradient-to-r from-green-500 to-emerald-600 text-white p-6 rounded-xl shadow-xl z-50 max-w-sm transform transition-all duration-300';
      notification.style.transform = 'translateX(100%)';
      
      notification.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="text-3xl">🎉</div>
          <div>
            <h4 class="font-bold text-lg">¡Felicitaciones!</h4>
            <p class="text-sm text-green-100">Has completado todas las lecciones disponibles. ¡Eres un experto en ciberseguridad!</p>
