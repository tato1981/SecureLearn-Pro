---
export interface Props {
  title: string;
  description: string;
  icon?: string;
  className?: string;
}

const { title, description, icon, className = "" } = Astro.props;
---

<div class={`bg-white rounded-lg shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow duration-300 ${className}`}>
  {icon && (
    <div class="flex items-center justify-center w-12 h-12 bg-primary-100 rounded-lg mb-4">
      <span class="text-2xl">{icon}</span>
    </div>
  )}
  <h3 class="text-lg font-semibold text-gray-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
</div>