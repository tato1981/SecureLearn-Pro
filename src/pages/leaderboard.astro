---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Ranking - SecureLearn Pro">
  <Navigation />
  
  <section class="bg-gradient-to-r from-purple-600 to-pink-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          🏆 Ranking de Campeones
        </h1>
        <p class="text-xl text-purple-100 mb-8 max-w-3xl mx-auto">
          Descubre quiénes lideran en conocimientos de ciberseguridad en tu institución
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 -mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-xl shadow-lg p-2 mb-8">
        <nav class="flex space-x-2">
          <button class="flex-1 py-3 px-4 rounded-lg font-medium text-white bg-purple-600 transition-colors">
            🏆 Individual
          </button>
          <button class="flex-1 py-3 px-4 rounded-lg font-medium text-gray-600 hover:text-purple-600 hover:bg-purple-50 transition-colors">
            👥 Departamentos
          </button>
          <button class="flex-1 py-3 px-4 rounded-lg font-medium text-gray-600 hover:text-purple-600 hover:bg-purple-50 transition-colors">
            📅 Semanal
          </button>
        </nav>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl shadow-lg border border-gray-200">
            <div class="p-6 border-b border-gray-200">
              <h2 class="text-xl font-bold text-gray-900">Ranking Individual</h2>
              <p class="text-gray-600 text-sm mt-1">Top empleados en conocimientos de ciberseguridad</p>
            </div>
            
            <div class="divide-y divide-gray-200">
              <div class="p-6 hover:bg-gray-50 transition-colors bg-gradient-to-r from-yellow-50 to-orange-50">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-4">
                    <div class="flex items-center justify-center w-12 h-12 rounded-full bg-yellow-100 text-yellow-600 font-bold text-lg">
                      👑
                    </div>
                    <div>
                      <h3 class="font-semibold text-gray-900">Ana María García</h3>
                      <p class="text-sm text-gray-600">Operaciones</p>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-bold text-purple-600 text-lg">2,850 pts</div>
                    <div class="text-sm text-gray-600">Nivel 29 • 95 lecciones</div>
                  </div>
                </div>
              </div>
              
              <div class="p-6 bg-blue-50 border-2 border-blue-200">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-4">
                    <div class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 font-bold text-lg">
                      #15
                    </div>
                    <div>
                      <h3 class="font-semibold text-gray-900">Tú</h3>
                      <p class="text-sm text-gray-600">Tu Departamento</p>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-bold text-blue-600 text-lg">150 pts</div>
                    <div class="text-sm text-gray-600">Nivel 2 • 3 lecciones</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Tu Progreso</h3>
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-gray-600">Posición actual</span>
                <span class="font-bold text-blue-600">#15</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>