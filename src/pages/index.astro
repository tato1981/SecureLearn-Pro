      initializeLessons() {
        document.addEventListener('DOMContentLoaded', () => {
          this.bindLessonButtons();
          this.updateLessonStates();
        });
      }

      bindLessonButtons() {
        const lessonButtons = document.querySelectorAll('.lesson-btn');
        lessonButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const lessonId = e.target.closest('.lesson-btn').dataset.lessonId;
            const lessonTitle = e.target.closest('.lesson-btn').dataset.lessonTitle;
            const lessonPoints = e.target.closest('.lesson-btn').dataset.lessonPoints;
            
            this.openLessonModal(lessonId, lessonTitle, lessonPoints);
          });
        });
      }

      updateLessonStates() {
        if (window.gameSystem) {
          const lessonButtons = document.querySelectorAll('.lesson-btn');
          lessonButtons.forEach(btn => {
            const lessonId = btn.dataset.lessonId;
            if (window.gameSystem.isLessonCompleted(lessonId)) {
              this.markLessonCompleted(btn);
            }
          });
        }
      }

      markLessonCompleted(button) {
        button.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'text-white');
        button.classList.add('bg-gray-100', 'text-gray-600', 'cursor-default');
        button.disabled = true;
        button.querySelector('.btn-text').textContent = '✓ Lección Completada';
      }

      openLessonModal(lessonId, lessonTitle, lessonPoints) {
        const modal = document.getElementById('lessonModal');
        const modalContent = document.getElementById('modalContent');
        
        let content = '';
        
        if (lessonId === 'phishing-basics') {
          content = this.getPhishingBasicsContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'social-engineering') {
          content = this.getSocialEngineeringContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'password-security') {
          content = this.getPasswordSecurityContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'manipulation-techniques') {
          content = this.getManipulationTechniquesContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'pretexting-financial') {
          content = this.getPretextingFinancialContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'secure-passwords') {
          content = this.getSecurePasswordsContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'two-factor-auth') {
          content = this.getTwoFactorAuthContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'superintendencia-guidelines') {
          content = this.getSuperintendenciaGuidelinesContent(lessonTitle, lessonPoints);
        } else if (lessonId === 'incident-reporting') {
          content = this.getIncidentReportingContent(lessonTitle, lessonPoints);
        } else {
          content = this.getGenericLessonContent(lessonTitle, lessonPoints);
        }
        
        modalContent.innerHTML = content;
        
        // Mostrar modal con animación
        modal.classList.remove('hidden');
        setTimeout(() => {
          modalContent.classList.remove('scale-95', 'opacity-0');
          modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);
        
