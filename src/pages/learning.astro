            'Calculadora de multas por incumplimiento'
          ],
          prerequisites: ['Conocimiento del sistema financiero colombiano']
        },
        'incident-reporting': {
          icon: '🚨',
          duration: '4 min',
          difficulty: 'Intermedio',
          category: 'Gestión de Incidentes',
          learningObjectives: [
            'Detectar e identificar incidentes de seguridad en tiempo real',
            'Aplicar procedimientos de contención inmediata',
            'Documentar evidencia forense de manera adecuada',
            'Cumplir plazos de reporte a la SFC (24 horas)'
          ],
          highlights: [
            'Simulador de respuesta a incidentes',
            'Plantillas de documentación forense',
            'Cronómetro de cumplimiento de plazos SFC',
            'Casos reales de incidentes en bancos colombianos'
          ],
          prerequisites: ['Directrices de la Superintendencia']
        }
      };

      return lessonsData[lessonId] || {
        icon: '📚',
        duration: '5 min',
        difficulty: 'Intermedio',
        category: 'General',
        learningObjectives: ['Contenido en desarrollo'],
        highlights: ['Lección en preparación'],
        prerequisites: []
      };
    }

    completeCurrentLesson() {
      if (this.currentLessonId && this.currentLessonPoints) {
        // Usar el sistema de gamificación global
        if (window.gameSystem) {
          window.gameSystem.completeLesson(this.currentLessonId, this.currentLessonPoints);
        }
        
        this.closeLessonModal();
        
        // Actualizar la UI de la tarjeta
        const lessonCard = document.querySelector(`[data-lesson-id="${this.currentLessonId}"]`);
        if (lessonCard) {
          const button = lessonCard.querySelector('button');
          if (button) {
            button.textContent = '✅ Completada';
            button.className = 'w-full bg-green-600 text-white py-2 px-4 rounded-lg font-medium cursor-default';
            button.disabled = true;
          }
        }
      }
    }
  }

  // Inicializar el sistema cuando se carga la página
  document.addEventListener('DOMContentLoaded', () => {
    console.log('🔥 DOMContentLoaded fired for Micro-Learning page');
    
    // Inicializar sistemas de autenticación y gamificación si no existen
    if (!window.authSystem) {
      console.log('🔧 Initializing authSystem...');
      window.authSystem = {
        currentUser: null,
        
        initialize() {
          const savedUser = localStorage.getItem('currentUser');
          if (savedUser) {
            this.currentUser = JSON.parse(savedUser);
            console.log('✅ User loaded from localStorage:', this.currentUser);
          }
        },
        
        isLoggedIn() {
          return this.currentUser !== null;
        },
        
        getCurrentUser() {
          return this.currentUser;
        }
      };
      
      // Inicializar el sistema de autenticación
      window.authSystem.initialize();
    }
    
    // Inicializar sistema de gamificación si no existe
    if (!window.gameSystem) {
      console.log('🔧 Initializing gameSystem...');
      window.gameSystem = {
        updateUI() {
          // Función básica para compatibilidad
          console.log('gameSystem.updateUI called');
        }
      };
    }
    
    window.microLearningSystem = new MicroLearningSystem();
    
    // Delay más largo para asegurar que el sistema de autenticación esté completamente cargado
    setTimeout(() => {
      console.log('🔥 Executing delayed initializeStatistics...');
      initializeStatistics();
    }, 500);
  });

  // También ejecutar si el DOM ya está listo
  if (document.readyState !== 'loading') {
    console.log('📄 Document already loaded, initializing immediately...');
    setTimeout(() => {
      console.log('📄 Immediate initialization executing...');
      initializeStatistics();
    }, 100);
  }

  // Sistema de estadísticas dinámicas
  function initializeStatistics() {
    console.log('🚀 initializeStatistics() called at:', new Date().toLocaleTimeString());
    console.log('🚀 Current page URL:', window.location.pathname);
    
    // Obtener datos del usuario desde localStorage directamente
    let currentUser = null;
    
    // Método 1: Desde authSystem si está disponible
    if (window.authSystem && window.authSystem.getCurrentUser) {
      currentUser = window.authSystem.getCurrentUser();
      console.log('🚀 User from authSystem:', currentUser);
    }
    
    // Método 2: Directamente desde localStorage
    if (!currentUser) {
      const savedUser = localStorage.getItem('currentUser');
      if (savedUser) {
        currentUser = JSON.parse(savedUser);
        console.log('🚀 User from localStorage directly:', currentUser);
      }
    }
    
    // Método 3: Desde authSystem localStorage
    if (!currentUser) {
      const authSystem = JSON.parse(localStorage.getItem('authSystem') || '{}');
      currentUser = authSystem.currentUser;
      console.log('🚀 User from authSystem localStorage:', currentUser);
    }
    
    console.log('🚀 Final currentUser:', currentUser);
    
    if (!currentUser) {
      console.log('❌ No authenticated user found - trying all methods failed');
      return;
    }

    console.log('✅ Inicializando estadísticas para:', currentUser.email);

    // Obtener progreso del usuario
    const userProgress = JSON.parse(localStorage.getItem(`userProgress_${currentUser.email}`) || '{}');
    const gameData = JSON.parse(localStorage.getItem(`gameData_${currentUser.email}`) || '{}');
    
    // Calcular estadísticas reales
    const completedLessons = Object.keys(userProgress).length;
    const totalPoints = gameData.totalPoints || 0;
    const currentLevel = gameData.currentLevel || 1;
    const currentLevelPoints = gameData.currentLevelPoints || 0;
    const nextLevelPoints = gameData.nextLevelPoints || 100;
    const streak = calculateStreak(currentUser.email);

    console.log('Estadísticas calculadas:', { completedLessons, totalPoints, currentLevel, streak });

    // Actualizar interfaz de estadísticas
    updateStatisticsUI({
      completedLessons,
      totalPoints,
      currentLevel,
      currentLevelPoints,
      nextLevelPoints,
      streak
    });

    // Actualizar logros
    updateAchievements(completedLessons, totalPoints, currentLevel, streak);
  }

  function calculateCurrentStreak(streakData, today) {
    const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000).toDateString();
    
    if (streakData.lastStudyDate === today) {
      return streakData.currentStreak || 1;
    } else if (streakData.lastStudyDate === yesterday) {
      return streakData.currentStreak || 0;
    } else {
      return 0;
    }
  }

  function updateStatisticsUI(stats) {
    console.log('Updating statistics UI with:', stats);
    
    // Solo actualizar las estadísticas mejoradas ya que eliminamos las tarjetas principales
    updateEnhancedStatistics(stats);
    
    // Actualizar logros
    updateAchievements(stats.completedLessons, stats.totalPoints, stats.currentLevel, stats.streak);
  }

  function updateEnhancedStatistics(stats) {
    console.log('updateEnhancedStatistics called with:', stats);
    console.log('Esta función ya no necesita actualizar elementos DOM ya que se eliminaron las tarjetas principales');
  }

  function updateAchievements(completedLessons, totalPoints, currentLevel, streak) {
    const achievementsContainer = document.getElementById('recentAchievements');
    if (!achievementsContainer) return;

    const achievements = [];

    // Logros por lecciones completadas
    if (completedLessons >= 1) {
      achievements.push({
        title: 'Primera Lección',
        description: 'Completaste tu primera lección',
        icon: '🎯',
        color: 'bg-green-100 text-green-700'
      });
    }
    
    if (completedLessons >= 3) {
      achievements.push({
        title: 'Estudiante Activo',
        description: 'Completaste 3 lecciones',
        icon: '📚',
        color: 'bg-blue-100 text-blue-700'
      });
    }
    
    if (completedLessons >= 5) {
      achievements.push({
        title: 'Experto en Formación',
        description: 'Completaste 5 lecciones',
        icon: '🏆',
        color: 'bg-purple-100 text-purple-700'
      });
    }

    // Logros por puntos
    if (totalPoints >= 100) {
      achievements.push({
        title: 'Centurión',
        description: 'Alcanzaste 100 puntos',
        icon: '💯',
        color: 'bg-yellow-100 text-yellow-700'
      });
    }

    // Logros por nivel
    if (currentLevel >= 2) {
      achievements.push({
        title: 'Subiendo Niveles',
        description: `Alcanzaste el nivel ${currentLevel}`,
        icon: '⭐',
        color: 'bg-orange-100 text-orange-700'
      });
    }

    // Logros por racha
    if (streak >= 3) {
      achievements.push({
        title: 'Estudiante Constante',
        description: `${streak} días consecutivos`,
        icon: '🔥',
        color: 'bg-red-100 text-red-700'
      });
    }

    // Mostrar logros (máximo 3 más recientes)
    if (achievements.length === 0) {
      achievementsContainer.innerHTML = `
        <div class="text-center text-gray-500 col-span-full">
          <p>Completa lecciones en el Dashboard para desbloquear logros</p>
        </div>
      `;
    } else {
      achievementsContainer.innerHTML = achievements.slice(-3).map(achievement => `
        <div class="p-4 rounded-lg ${achievement.color} text-center">
          <div class="text-2xl mb-2">${achievement.icon}</div>
          <div class="font-semibold text-sm">${achievement.title}</div>
          <div class="text-xs mt-1 opacity-80">${achievement.description}</div>
        </div>
      `).join('');
    }
  }

  function calculateStreak(userEmail) {
    const streakData = JSON.parse(localStorage.getItem(`streak_${userEmail}`) || '{}');
    const today = new Date().toDateString();
    const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000).toDateString();
    
    if (streakData.lastStudyDate === today) {
      return streakData.currentStreak || 1;
    } else if (streakData.lastStudyDate === yesterday) {
      return streakData.currentStreak || 0;
    } else {
      return 0;
    }
  }

  // Actualizar estadísticas cuando el usuario navega de vuelta desde el dashboard
  window.addEventListener('focus', () => {
    console.log('Window focus detected, updating statistics...');
    setTimeout(initializeStatistics, 500);
  });

  // Escuchar eventos de storage para actualizaciones en tiempo real
  window.addEventListener('storage', (e) => {
    if (e.key && (e.key.includes('dailyStats_') || e.key.includes('userProgress_') || e.key.includes('gameData_') || e.key === 'statsUpdateTrigger')) {
      console.log('Storage change detected:', e.key, 'Value:', e.newValue);
      if (e.key === 'statsUpdateTrigger') {
        console.log('Stats update trigger received from Dashboard');
      }
      setTimeout(initializeStatistics, 100);
    }
  });

  // Funcionalidad del botón "Continuar con la Siguiente Lección"
  document.addEventListener('click', (e) => {
    if (e.target && e.target.id === 'continueNextLesson') {
      redirectToNextLesson();
    }
  });

  function redirectToNextLesson() {
    console.log('🎯 Redirecting to next lesson...');
    
    // Obtener usuario actual
    let currentUser = null;
    if (window.authSystem && window.authSystem.getCurrentUser) {
      currentUser = window.authSystem.getCurrentUser();
    } else {
      const savedUser = localStorage.getItem('currentUser');
      if (savedUser) {
        currentUser = JSON.parse(savedUser);
      }
    }

    if (!currentUser) {
      console.log('❌ No authenticated user found');
      alert('Por favor, inicia sesión para continuar con las lecciones.');
      return;
    }

    // Obtener progreso del usuario
    const userProgress = JSON.parse(localStorage.getItem(`userProgress_${currentUser.email}`) || '{}');
    console.log('📚 User progress:', userProgress);

    // Lista de lecciones en orden
    const lessonOrder = [
      'phishing-basics',
      'social-engineering', 
      'password-security',
      'manipulation-techniques',
      'secure-communications',
      'mobile-security',
      'financial-regulations',
      'data-protection',
      'incident-reporting'
    ];

    // Encontrar la siguiente lección no completada
    let nextLessonId = null;
    for (const lessonId of lessonOrder) {
      if (!userProgress[lessonId]) {
        nextLessonId = lessonId;
        break;
      }
    }

    if (nextLessonId) {
      console.log('➡️ Next lesson to complete:', nextLessonId);
      // Redirigir al Dashboard con la lección específica
      window.location.href = `/?lesson=${nextLessonId}`;
    } else {
      console.log('🎉 All lessons completed!');
      alert('¡Felicitaciones! Has completado todas las lecciones disponibles. 🎉');
      // Redirigir al dashboard principal
      window.location.href = '/';
    }
  }
</script>
